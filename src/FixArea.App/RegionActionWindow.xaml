<Window
    x:Class="FixArea.App.RegionActionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lock this region">

    <Grid Padding="20" RowSpacing="12" Width="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="What should FixArea do with this region?" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="BoundsText" Opacity="0.7"/>

        <StackPanel Grid.Row="2" Spacing="8">
            <Button Content="Lock region only" HorizontalAlignment="Stretch" Click="LockOnly_Click"/>
            <Button Content="Lock and keep overlay on top" HorizontalAlignment="Stretch" Click="AlwaysOnTop_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Or pin an open window into this region"/>
            <ComboBox x:Name="WindowCombo" HorizontalAlignment="Stretch" PlaceholderText="Choose a window"/>
            <Button Content="Pin selected window" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Pin_Click"/>
        </StackPanel>

        <Button Grid.Row="4" Content="Cancel" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </Grid>
</Window>
